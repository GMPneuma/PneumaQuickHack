<form class="pneuma-quickhack-settings" autocomplete="off">
  <div class="pneuma-settings-workflows">
    <section class="pneuma-workflow-row" aria-label="{{localize "PNEUMA_QUICKHACK.Settings.NpcToNpc.Title"}}">
      <div class="pneuma-workflow-path">
        <div class="pneuma-workflow-actor npc">
          <i class="fas fa-robot"></i>
          <strong>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Npc"}}</strong>
          <small>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Attacker"}}</small>
        </div>
        <i class="fas fa-arrow-right pneuma-workflow-arrow"></i>
        <div class="pneuma-workflow-actor npc">
          <i class="fas fa-robot"></i>
          <strong>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Npc"}}</strong>
          <small>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Target"}}</small>
        </div>
      </div>
      <div class="pneuma-workflow-fixed">
        <i class="fas fa-lock"></i>
        <span>{{localize "PNEUMA_QUICKHACK.Settings.NpcToNpc.Fact"}}</span>
      </div>
    </section>

    <section class="pneuma-workflow-row" aria-label="{{localize "PNEUMA_QUICKHACK.Settings.NpcToPlayer.Title"}}">
      <div class="pneuma-workflow-path">
        <div class="pneuma-workflow-actor npc">
          <i class="fas fa-robot"></i>
          <strong>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Npc"}}</strong>
          <small>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Attacker"}}</small>
        </div>
        <i class="fas fa-arrow-right pneuma-workflow-arrow"></i>
        <div class="pneuma-workflow-actor player">
          <i class="fas fa-user"></i>
          <strong>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Player"}}</strong>
          <small>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Target"}}</small>
        </div>
      </div>

      <div class="pneuma-workflow-actions">
        <article class="pneuma-workflow-action jack-in">
          <h3><i class="fas fa-network-wired"></i> {{localize "PNEUMA_QUICKHACK.Settings.JackIn.Title"}}</h3>
          <p class="pneuma-settings-note">{{localize "PNEUMA_QUICKHACK.Settings.NpcToPlayer.JackInFact"}}</p>
          <div class="pneuma-settings-field">
            <label for="npc-player-jack-in-audience">{{localize "PNEUMA_QUICKHACK.Settings.Question.DetectedJackInAudience"}}</label>
            <select id="npc-player-jack-in-audience" name="npcToPlayerJackInAudience">
              {{selectOptions detectedPlayerChoices selected=config.npcToPlayerJackInAudience localize=true}}
            </select>
          </div>
          <div class="pneuma-settings-field">
            <label for="npc-player-jack-in-totals">{{localize "PNEUMA_QUICKHACK.Settings.Question.JackInTotals"}}</label>
            <select id="npc-player-jack-in-totals" name="npcToPlayerJackInShowTotals">
              {{selectOptions totalsChoices selected=config.npcToPlayerJackInShowTotals localize=true}}
            </select>
          </div>
          <div class="pneuma-settings-field">
            <label for="npc-player-jack-in-identity">{{localize "PNEUMA_QUICKHACK.Settings.Question.NpcIdentity"}}</label>
            <select id="npc-player-jack-in-identity" name="npcToPlayerJackInRevealAttacker">
              {{selectOptions identityChoices selected=config.npcToPlayerJackInRevealAttacker localize=true}}
            </select>
          </div>
        </article>

        <article class="pneuma-workflow-action quickhack">
          <h3><i class="fas fa-microchip"></i> {{localize "PNEUMA_QUICKHACK.Settings.Quickhack.Title"}}</h3>
          <p class="pneuma-settings-note">{{localize "PNEUMA_QUICKHACK.Settings.NpcToPlayer.QuickhackFact"}}</p>
          <div class="pneuma-settings-field">
            <label for="npc-player-quickhack-audience">{{localize "PNEUMA_QUICKHACK.Settings.Question.QuickhackAudience"}}</label>
            <select id="npc-player-quickhack-audience" name="npcToPlayerQuickhackAudience">
              {{selectOptions detectedPlayerChoices selected=config.npcToPlayerQuickhackAudience localize=true}}
            </select>
          </div>
          <div class="pneuma-settings-field">
            <label for="npc-player-quickhack-identity">{{localize "PNEUMA_QUICKHACK.Settings.Question.NpcIdentity"}}</label>
            <select id="npc-player-quickhack-identity" name="npcToPlayerQuickhackRevealAttacker">
              {{selectOptions identityChoices selected=config.npcToPlayerQuickhackRevealAttacker localize=true}}
            </select>
          </div>
        </article>
      </div>
    </section>

    <section class="pneuma-workflow-row" aria-label="{{localize "PNEUMA_QUICKHACK.Settings.PlayerToNpc.Title"}}">
      <div class="pneuma-workflow-path">
        <div class="pneuma-workflow-actor player">
          <i class="fas fa-user"></i>
          <strong>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Player"}}</strong>
          <small>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Attacker"}}</small>
        </div>
        <i class="fas fa-arrow-right pneuma-workflow-arrow"></i>
        <div class="pneuma-workflow-actor npc">
          <i class="fas fa-robot"></i>
          <strong>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Npc"}}</strong>
          <small>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Target"}}</small>
        </div>
      </div>

      <div class="pneuma-workflow-actions">
        <article class="pneuma-workflow-action jack-in">
          <h3><i class="fas fa-network-wired"></i> {{localize "PNEUMA_QUICKHACK.Settings.JackIn.Title"}}</h3>
          <p class="pneuma-settings-note">{{localize "PNEUMA_QUICKHACK.Settings.PlayerToNpc.JackInFact"}}</p>
          <div class="pneuma-settings-field">
            <label for="player-npc-awareness">{{localize "PNEUMA_QUICKHACK.Settings.Question.ShareNpcAwareness"}}</label>
            <select id="player-npc-awareness" name="playerToNpcJackInAudience">
              {{selectOptions awarenessChoices selected=config.playerToNpcJackInAudience localize=true}}
            </select>
          </div>
        </article>
        <article class="pneuma-workflow-action quickhack fixed-action">
          <h3><i class="fas fa-microchip"></i> {{localize "PNEUMA_QUICKHACK.Settings.Quickhack.Title"}}</h3>
          <p class="pneuma-settings-note">{{localize "PNEUMA_QUICKHACK.Settings.PlayerToNpc.QuickhackFact"}}</p>
        </article>
      </div>
    </section>

    <section class="pneuma-workflow-row" aria-label="{{localize "PNEUMA_QUICKHACK.Settings.PlayerToPlayer.Title"}}">
      <div class="pneuma-workflow-path">
        <div class="pneuma-workflow-actor player">
          <i class="fas fa-user"></i>
          <strong>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Player"}}</strong>
          <small>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Attacker"}}</small>
        </div>
        <i class="fas fa-arrow-right pneuma-workflow-arrow"></i>
        <div class="pneuma-workflow-actor player">
          <i class="fas fa-user"></i>
          <strong>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Player"}}</strong>
          <small>{{localize "PNEUMA_QUICKHACK.Settings.Actor.Target"}}</small>
        </div>
      </div>
      <div class="pneuma-workflow-fixed public">
        <i class="fas fa-eye"></i>
        <span>{{localize "PNEUMA_QUICKHACK.Settings.PlayerToPlayer.Fact"}}</span>
      </div>
    </section>
  </div>

  <footer class="pneuma-settings-footer">
    <button type="submit"><i class="fas fa-save"></i> {{localize "PNEUMA_QUICKHACK.Settings.Menu.Save"}}</button>
  </footer>
</form>
